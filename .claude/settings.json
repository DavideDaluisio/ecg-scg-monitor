{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run e2e)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run fixtures)",
      "Bash(npx vitest:*)",
      "Bash(npx prettier:*)",
      "Bash(node scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": ["Bash(git add public/samples/local/*)", "Bash(git push --force:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git commit *)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "The user just ran 'git commit'. Extract the commit message from $ARGUMENTS (look in tool_input.command for the -m flag or message). Check if it contains 'Complete M' or 'completed milestone' followed by a number. If found, extract the milestone number and respond with: {\"systemMessage\": \"Milestone completed! You can tag this version with: git tag M<number>. Would you like to run this command now?\"}. If no milestone pattern found, respond with an empty response."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
